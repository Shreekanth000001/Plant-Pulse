# PlantPulse Docker Compose Environment Template
# Copy this file to .env before starting the stack:
#   cp .env.example .env && sed -i "s/replace_with_a_secure_random_password/$(openssl rand -hex 16)/" .env

# Backend MQTT Broker Authentication (Required - no default)
BACKEND_MQTT_USER=backend_service
BACKEND_MQTT_PASSWORD=replace_with_a_secure_random_password

# Demo Simulator Client Credentials (demo only)
MQTT_USER=device_plant_demo_membrane
MQTT_PASSWORD=demo_membrane_secure_token_123
MQTT_CLIENT_ID=client_demo_membrane_sim

# Water Plant Simulator Credentials (demo only)
WATER_MQTT_USER=device_plant_water_district_9
WATER_MQTT_PASSWORD=water_district_edge_key_771
WATER_MQTT_CLIENT_ID=gateway_district9_cellular

# Water Plant Viewer Token (demo only - seeds platform.db on first boot)
PLANT_WATER_DISTRICT_9_VIEWER_TOKEN=district9_read_secret_token_889

# Web & API Network Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
DEMO_HINTS=true
NEXT_PUBLIC_DEMO_HINTS=true

# Simulator Tuning (Optional)
SIMULATOR_REPAIR_DELAY_SECONDS=90
SIMULATOR_DRIFT_SCALE=0.1

# Admin API Configuration (Optional)
ADMIN_TOKEN=
MOUNT_ADMIN_ENDPOINTS=false

# Retention Worker Configuration (Optional)
ENABLE_RETENTION_WORKER=true
RETENTION_DAYS=30

# Clerk Authentication (Optional during transition, required for Clerk auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_PEM_PUBLIC_KEY=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000



